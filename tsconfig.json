{
    "compilerOptions": {
        "target": "esnext",
        "strict": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "isolatedModules": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "lib": ["esnext", "dom"],
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true
    },
    "exclude": ["node_modules", "docs"],
    "include": ["src"]
}
