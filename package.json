{
    "name": "rust-books",
    "type": "module",
    "version": "1.0.0",
    "license": "MIT",
    "engines": {
        "node": ">=25"
    },
    "scripts": {
        "start": "node src/main.ts",
        "generate-site": "node src/generate-site.ts",
        "lint": "oxlint",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "typecheck": "tsc --noEmit",
        "knip": "knip"
    },
    "dependencies": {
        "p-limit": "^6.1.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "playwright": "^1.48.2",
        "toml": "^3.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.6.0",
        "knip": "^5.0.0",
        "oxfmt": "^0.7.0",
        "oxlint": "^1.0.0",
        "simple-git-hooks": "^2.11.0",
        "typescript": "^5.8.3"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm lint && pnpm format && pnpm knip && node src/generate-site.ts && git add docs/index.html"
    }
}
