{
  "name": "rust-books",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "generate-site": "node src/generate-site.ts",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.62.1",
    "toml": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "knip": "^6.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm format && pnpm knip && node src/generate-site.ts && git add docs/index.html"
  },
  "engines": {
    "node": ">=26"
  }
}
